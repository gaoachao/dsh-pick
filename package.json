{
  "name": "dsh-pick",
  "version": "0.0.1",
  "description": "Point at a UI element and give DeepSeek Harness the context to change it. Development scaffold.",
  "type": "module",
  "license": "MIT",
  "author": "gaoachao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaoachao/dsh-pick.git"
  },
  "homepage": "https://github.com/gaoachao/dsh-pick#readme",
  "bugs": {
    "url": "https://github.com/gaoachao/dsh-pick/issues"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "frontend", "element-picker"],
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.30.3",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/shared/types.d.ts",
      "default": "./lib/shared/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "docs", "README.md", "README.zh-CN.md", "LICENSE"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build && pnpm smoke",
    "smoke": "node scripts/smoke.mjs",
    "prepare": "pnpm build",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "typescript": "5.9.3"
  }
}
